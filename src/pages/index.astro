---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import HeroSection from '../components/HeroSection.astro';
import WhySection from '../components/WhySection.astro';
import OpportunitySection from '../components/OpportunitySection.astro';
import VisionSection from '../components/VisionSection.astro';
import AcquireSection from '../components/AcquireSection.astro';
import InquiryModal from '../components/InquiryModal.astro';
import Footer from '../components/Footer.astro';

const site = await getEntry('site', 'default');
const data = site!.data;
---

<BaseLayout title={`${data.domain} | The Definitive HVAC Domain — Now Available`}
             description={`${data.domain} — The definitive premium domain for the global HVAC industry. Perfect for reviews, consultant platforms, contractor marketplaces, and lead generation. Now available for acquisition.`}>
  <Nav />
  <main>
    <HeroSection
      domain={data.domain}
      heroImage={data.heroImage}
      heroStreamUrl={data.heroStreamUrl}
      trustPoints={data.trustPoints}
      price={data.price}
    />
    <WhySection cards={data.valueCards} />
    <OpportunitySection metrics={data.marketMetrics} />
    <VisionSection cards={data.visionCards} />
    <AcquireSection
      price={data.price}
      email={data.email}
      terms={data.acquisitionTerms}
    />
  </main>
  <Footer
    disclaimer={data.disclaimer}
    footerLinks={data.footerLinks}
  />
  <InquiryModal />
</BaseLayout>
