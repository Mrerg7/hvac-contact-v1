---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import HeroSection from '../components/HeroSection.astro';
import WhySection from '../components/WhySection.astro';
import OpportunitySection from '../components/OpportunitySection.astro';
import VisionSection from '../components/VisionSection.astro';
import AcquireSection from '../components/AcquireSection.astro';
import InquiryModal from '../components/InquiryModal.astro';
import ExitIntent from '../components/ExitIntent.astro';
import Footer from '../components/Footer.astro';
import { parsePriceNumeric } from '../utils/seo';

const site = await getEntry('site', 'default');
const data = site!.data;
const priceNumeric = parsePriceNumeric(data.price);
const pageTitle = `${data.domain} | Premium Domain for Sale | Desert Rich`;
const pageDescription = `${data.domain} is available for acquisition at ${data.price} USD. Exact-match premium HVAC domain for reviews, contractor marketplaces, and lead platforms. Secure escrow. Inquire today.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  price={data.price}
  priceNumeric={priceNumeric}
>
  <Nav />
  <main id="main">
    <HeroSection
      domain={data.domain}
      heroImage={data.heroImage}
      heroStreamUrl={data.heroStreamUrl}
      trustPoints={data.trustPoints}
      price={data.price}
    />
    <WhySection cards={data.valueCards} />
    <OpportunitySection metrics={data.marketMetrics} />
    <VisionSection cards={data.visionCards} />
    <AcquireSection
      price={data.price}
      email={data.email}
      terms={data.acquisitionTerms}
    />
  </main>
  <Footer
    disclaimer={data.disclaimer}
    footerLinks={data.footerLinks}
    price={data.price}
    email={data.email}
  />
  <InquiryModal salesEmail={data.email} />
  <ExitIntent />
</BaseLayout>
