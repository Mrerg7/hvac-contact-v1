---
interface Props {
  domain: string;
  heroImage: string;
  heroStreamUrl: string;
  trustPoints: string[];
  price: string;
}

const { domain, heroImage, heroStreamUrl, trustPoints, price } = Astro.props;
---

<header class="relative isolate min-h-[100svh] flex flex-col justify-end border-b border-white/10 overflow-hidden">
  <!-- Full-bleed Cloudflare Stream hero -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-stream absolute inset-0">
      <iframe
        src={heroStreamUrl}
        title={`${domain} hero video`}
        loading="eager"
        class="absolute inset-0 h-full w-full border-0 pointer-events-none"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
        allowfullscreen
      ></iframe>
    </div>
    <div class="absolute inset-0 bg-slate-950/55 sm:bg-slate-950/45"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-slate-950/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-transparent to-slate-950/40"></div>
    <img
      src={heroImage}
      alt=""
      width="1200"
      height="630"
      decoding="async"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    />
  </div>

  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 pt-28 pb-14 sm:pt-32 sm:pb-16 md:pb-20 text-center hero-copy">
    <p class="mb-4 text-xs sm:text-sm font-semibold tracking-[0.18em] uppercase text-cyan-300/90">
      Premium domain · Available now · {price} USD
    </p>

    <h1 class="text-[2.5rem] leading-none sm:text-5xl md:text-7xl font-display tracking-tighter font-bold mb-4 break-words drop-shadow-sm">
      hvac<span class="text-cyan-400">.</span>contact
    </h1>

    <p class="max-w-2xl mx-auto text-xl sm:text-2xl md:text-3xl text-slate-100 tracking-tight mb-4 drop-shadow-sm">
      The definitive destination for everything HVAC.
    </p>

    <p class="max-w-xl mx-auto text-base sm:text-lg text-slate-200/90 mb-8">
      Own the most powerful digital asset in heating, ventilation, and air conditioning.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
      <a href="#acquire"
         class="group tap-target w-full sm:w-auto inline-flex items-center justify-center gap-x-3 px-9 py-4 rounded-3xl bg-cyan-400 hover:bg-white text-slate-950 font-semibold text-lg transition-all active:scale-[0.985] shadow-xl shadow-cyan-400/20">
        <span>Buy Now — {price}</span>
        <i class="fa-solid fa-arrow-right group-active:translate-x-0.5 transition-transform" aria-hidden="true"></i>
      </a>

      <button type="button"
              data-open-inquiry="make-offer"
              class="tap-target w-full sm:w-auto inline-flex items-center justify-center gap-x-2 px-8 py-4 rounded-3xl border border-white/25 bg-slate-950/30 backdrop-blur-sm hover:bg-white/10 font-medium text-base transition-all active:scale-[0.985]">
        <i class="fa-solid fa-handshake" aria-hidden="true"></i>
        <span>Make Offer</span>
      </button>

      <button type="button"
              data-open-inquiry="contact-agent"
              class="tap-target w-full sm:w-auto inline-flex items-center justify-center gap-x-2 px-8 py-4 rounded-3xl border border-white/15 bg-white/5 hover:bg-white/10 font-medium text-base transition-all active:scale-[0.985]">
        <i class="fa-regular fa-envelope" aria-hidden="true"></i>
        <span>Contact Agent</span>
      </button>
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-slate-300">
      {trustPoints.map((point) => (
        <div class="flex items-center gap-x-2">
          <i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i>
          <span>{point}</span>
        </div>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-slate-400">
      <span class="inline-flex items-center gap-x-2">
        <i class="fa-solid fa-lock text-emerald-400" aria-hidden="true"></i>
        Escrow.com / DAN.com ready
      </span>
      <span class="inline-flex items-center gap-x-2" id="viewer-count" aria-live="polite">
        <i class="fa-solid fa-eye text-cyan-400" aria-hidden="true"></i>
        <span data-viewer-label>Serious buyers reviewing this listing</span>
      </span>
      <span class="inline-flex items-center gap-x-2">
        <i class="fa-solid fa-shield-halved text-cyan-400" aria-hidden="true"></i>
        SSL secured transfer
      </span>
    </div>
  </div>
</header>

<style>
  .hero-stream {
    transform: scale(1.12);
    transform-origin: center center;
  }

  .hero-copy {
    animation: heroRise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy {
      animation: none;
    }

    .hero-stream {
      transform: none;
    }
  }
</style>

<script>
  // Soft social proof — local session seed, not fabricated analytics spam
  const label = document.querySelector('[data-viewer-label]');
  if (label) {
    const seed = 3 + Math.floor(Math.random() * 5);
    label.textContent = `${seed} qualified buyers viewed this listing today`;
  }
</script>
