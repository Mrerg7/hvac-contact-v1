---
interface Props {
  domain: string;
  heroImage: string;
  heroStreamUrl: string;
  trustPoints: string[];
  price: string;
}

const { domain, heroImage, heroStreamUrl, trustPoints, price } = Astro.props;
---

<header class="relative isolate min-h-[100svh] flex flex-col justify-end border-b border-white/10 overflow-hidden">
  <!-- Full-bleed Cloudflare Stream hero -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-stream absolute inset-0">
      <iframe
        src={heroStreamUrl}
        title={`${domain} hero video`}
        loading="eager"
        class="absolute inset-0 h-full w-full border-0 pointer-events-none"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
        allowfullscreen
      ></iframe>
    </div>
    <!-- Readability overlays: keep CTAs legible on mobile + desktop -->
    <div class="absolute inset-0 bg-slate-950/55 sm:bg-slate-950/45"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/50 to-slate-950/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950/70 via-transparent to-slate-950/40"></div>
    <!-- Poster fallback while stream loads -->
    <img
      src={heroImage}
      alt=""
      width="1200"
      height="630"
      decoding="async"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
    />
  </div>

  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 pt-28 pb-14 sm:pt-32 sm:pb-16 md:pb-20 text-center hero-copy">
    <h1 class="text-[2.5rem] leading-none sm:text-5xl md:text-7xl font-display tracking-tighter font-bold mb-4 break-words drop-shadow-sm">
      hvac<span class="text-cyan-400">.</span>contact
    </h1>

    <p class="max-w-2xl mx-auto text-xl sm:text-2xl md:text-3xl text-slate-100 tracking-tight mb-4 drop-shadow-sm">
      The definitive destination for everything HVAC.
    </p>

    <p class="max-w-xl mx-auto text-base sm:text-lg text-slate-200/90 mb-10">
      Own the most powerful digital asset in heating, ventilation, and air conditioning.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-4">
      <a href="#acquire"
         class="group w-full sm:w-auto inline-flex items-center justify-center gap-x-3 px-9 py-4 rounded-3xl bg-cyan-400 hover:bg-white text-slate-950 font-semibold text-lg transition-all active:scale-[0.985] shadow-xl shadow-cyan-400/20">
        <span>Acquire for {price}</span>
        <i class="fa-solid fa-arrow-right group-active:translate-x-0.5 transition-transform"></i>
      </a>

      <button type="button"
              onclick="document.getElementById('inquiry-modal').classList.remove('hidden'); document.getElementById('inquiry-modal').classList.add('flex')"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-x-2 px-8 py-4 rounded-3xl border border-white/25 bg-slate-950/30 backdrop-blur-sm hover:bg-white/10 font-medium text-base transition-all active:scale-[0.985]">
        <i class="fa-regular fa-envelope"></i>
        <span>Inquire Privately</span>
      </button>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-slate-300">
      {trustPoints.map((point) => (
        <div class="flex items-center gap-x-2">
          <i class="fa-solid fa-check text-emerald-400"></i>
          <span>{point}</span>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  .hero-stream {
    transform: scale(1.12);
    transform-origin: center center;
  }

  .hero-copy {
    animation: heroRise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes heroRise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy {
      animation: none;
    }

    .hero-stream {
      transform: none;
    }
  }
</style>
