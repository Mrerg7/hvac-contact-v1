---
import { getCanonicalUrl, buildProductSchema, buildOrganizationSchema, buildWebPageSchema } from '../utils/seo';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  price?: string;
  priceNumeric?: string;
  availability?: string;
}

const site = Astro.site ?? new URL('https://hvac.contact');
const domain = site.hostname.replace(/^www\./, '');
const fullUrl = getCanonicalUrl(site, Astro.props.path ?? Astro.url.pathname);

const price = Astro.props.price ?? '$400,000';
const priceNumeric = Astro.props.priceNumeric ?? '400000';

const title =
  Astro.props.title ??
  `${domain} | Premium Domain for Sale | Desert Rich`;

const description =
  Astro.props.description ??
  `${domain} is available for acquisition at ${price} USD. Exact-match premium HVAC domain for reviews, contractor marketplaces, and lead platforms. Secure escrow. Inquire today.`;

const orgSchema = buildOrganizationSchema(domain, fullUrl, description);
const productSchema = buildProductSchema({
  domain,
  url: fullUrl,
  description,
  priceNumeric,
  currency: 'USD',
});
const webPageSchema = buildWebPageSchema({
  domain,
  url: fullUrl,
  title,
  description,
});
---

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="keywords" content="hvac.contact for sale, buy .contact domains, HVAC domain marketplace, premium domain names, investment domains, HVAC domain for sale, exact-match domain">
<meta name="author" content="Desert Rich">

<!-- Canonical -->
<link rel="canonical" href={fullUrl}>
<link rel="alternate" hreflang="en" href={fullUrl}>
<link rel="alternate" hreflang="x-default" href={fullUrl}>

<!-- Open Graph -->
<meta property="og:type" content="product">
<meta property="og:locale" content="en_US">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={fullUrl}>
<meta property="og:site_name" content={domain}>
<meta property="og:image" content="https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/335b1bdd-ec88-44ef-8d19-b87ae2d69700/public">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${domain} — premium domain for sale`}>
<meta property="product:price:amount" content={priceNumeric}>
<meta property="product:price:currency" content="USD">
<meta property="product:availability" content="in stock">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/335b1bdd-ec88-44ef-8d19-b87ae2d69700/public">
<meta name="twitter:image:alt" content={`${domain} — premium domain for sale`}>

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
